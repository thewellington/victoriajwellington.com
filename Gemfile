# All Ruby gem dependencies for this site are managed with Bundler.
# - Install:  bundle install
# - Run:      bundle exec jekyll build   (or: bundle exec jekyll serve)
#            ./bin/jekyll is a thin wrapper that always goes through `bundle exec`.
# Commit Gemfile and Gemfile.lock; after pulling changes, run `bundle install` again.

